# Copiá este archivo como .env y completalo. El .env está en .gitignore:
# las claves nunca se suben al repo.

# Dónde vive Browth. En producción: https://browth-sandy.vercel.app
BROWTH_URL=https://browth-sandy.vercel.app

# La llave con la que n8n deja leads. Tiene que ser IDÉNTICA a la que cargaste
# en Vercel como BROWTH_INGESTA_TOKEN. Inventala larga, por ejemplo:
# openssl rand -hex 24
BROWTH_INGESTA_TOKEN=

# El código de acceso del equipo. Solo hace falta para el flujo de competencia,
# que sí pasa por el portero de la app.
BROWTH_ACCESS_CODE=
