# Copiá este archivo como .env y completalo. El .env está en .gitignore:
# las claves nunca se suben al repo.

# Dónde vive Browth.
#   Desarrollo: http://host.docker.internal:3000
#     (desde adentro del contenedor, "localhost" es el contenedor mismo)
#   Producción: https://browth-sandy.vercel.app
BROWTH_URL=http://host.docker.internal:3000

# La llave con la que n8n deja leads. Tiene que ser IDÉNTICA a la
# BROWTH_INGESTA_TOKEN del .env.local de Browth (y a la de Vercel, cuando pase
# a producción). Inventala larga:  openssl rand -hex 24
BROWTH_INGESTA_TOKEN=

# El código de acceso del equipo. Solo hace falta para el flujo de competencia,
# que sí pasa por el portero de la app. En desarrollo podés dejarlo vacío.
BROWTH_ACCESS_CODE=
