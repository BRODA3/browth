# Copiá este archivo a .env.local y completá las claves. En producción van en
# Vercel → Settings → Environment Variables (nunca en el repo).
# Ver SECURITY.md para qué protege cada una.

# Claude: Brodita y los agentes de investigación. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apify: búsqueda de empresas en Google Maps. https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Código de acceso del equipo. Sin esto la app queda abierta: cualquiera con el
# link puede hacer trabajar a los agentes con tus claves. Inventá uno largo.
BROWTH_ACCESS_CODE=

# Webhook de WhatsApp e Instagram (opcional).
META_VERIFY_TOKEN=
META_APP_SECRET=
